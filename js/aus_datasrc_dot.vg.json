
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Who Contributed Australia's Rabbit Occurrence Records?",
    "subtitle": "Top 12 data sources ranked by number of records"
  },
  "width": 680,
  "height": 420,
  "data": {
    "url": "data/rabbit_source_counts.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.DataSourceName) && datum.DataSourceName != ''"
    },
    {
      "calculate": "toNumber(datum.RecordCount)",
      "as": "RecordCount"
    },
    {
      "filter": "isValid(datum.RecordCount) && datum.RecordCount > 0"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "SourceRank"
        }
      ],
      "sort": [
        {
          "field": "RecordCount",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.SourceRank <= 12"
    }
  ],
  "mark": {
    "type": "circle",
    "size": 150,
    "color": "#B54A42",
    "opacity": 0.85
  },
  "encoding": {
    "y": {
      "field": "DataSourceName",
      "type": "nominal",
      "sort": {
        "field": "RecordCount",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelLimit": 270,
        "labelFontSize": 11
      }
    },
    "x": {
      "field": "RecordCount",
      "type": "quantitative",
      "title": "Number of occurrence records (square-root scale)",
      "scale": {
        "type": "sqrt",
        "zero": true
      },
      "axis": {
        "format": "~s",
        "grid": true
      }
    },
    "tooltip": [
      {
        "field": "DataSourceName",
        "type": "nominal",
        "title": "Data source"
      },
      {
        "field": "RecordCount",
        "type": "quantitative",
        "title": "Occurrence records",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E8E8E8"
    }
  }
}
