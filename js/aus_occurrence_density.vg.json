
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Have Rabbits Been Recorded Across Australia?",
    "subtitle": [
      "Occupied 10 km survey grid cells from the Australian National Rabbit Database",
      "Each dot represents one occupied 10 km × 10 km grid cell, not one rabbit"
    ]
  },
  "width": 750,
  "height": 490,
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 800
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E5F0F4"
      }
    },
    {
      "data": {
        "graticule": {
          "step": [5, 5]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#B5CED7",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "data/au-states-topo.json",
        "format": {
          "type": "topojson",
          "feature": "austates"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F5F1EB",
        "stroke": "#888888",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/rabbit_grid_counts.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.Longitude)",
          "as": "Longitude"
        },
        {
          "calculate": "toNumber(datum.Latitude)",
          "as": "Latitude"
        },
        {
          "calculate": "toNumber(datum.RecordCount)",
          "as": "RecordCount"
        },
        {
          "filter": "isValid(datum.Longitude) && isValid(datum.Latitude) && datum.Longitude >= 110 && datum.Longitude <= 155 && datum.Latitude >= -45 && datum.Latitude <= -10 && isValid(datum.RecordCount) && datum.RecordCount > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#B54A42",
        "opacity": 0.65,
        "size": 16
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "AustraliaUTMGrid10Km_ID",
            "type": "nominal",
            "title": "10 km grid cell"
          },
          {
            "field": "RecordCount",
            "type": "quantitative",
            "title": "Occurrence records",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
