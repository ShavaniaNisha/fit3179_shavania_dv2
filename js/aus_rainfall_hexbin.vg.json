{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Hexbin showing survey observation density across average annual rainfall and rabbit abundance.",
  "background": "transparent",
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/aus_rainfall_hexbin.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.HexCol) * 40",
      "as": "RainfallMm"
    },
    {
      "calculate": "toNumber(datum.HexRow) * 0.16 + (toNumber(datum.HexCol) % 2 == 0 ? 0 : 0.08)",
      "as": "LogAbundance"
    },
    {
      "calculate": "toNumber(datum.ObservationCount)",
      "as": "ObservationCount"
    },
    {
      "filter": "isValid(datum.RainfallMm) && isValid(datum.LogAbundance) && isValid(datum.ObservationCount) && datum.RainfallMm >= 0 && datum.RainfallMm <= 2000 && datum.LogAbundance >= 0 && datum.ObservationCount > 0"
    }
  ],
  "mark": {
    "type": "point",
    "shape": "M0,-1 L0.866,-0.5 L0.866,0.5 L0,1 L-0.866,0.5 L-0.866,-0.5 Z",
    "filled": true,
    "size": 330,
    "opacity": 0.95,
    "stroke": "#F5F1EB",
    "strokeWidth": 0.3
  },
  "encoding": {
    "x": {
      "field": "RainfallMm",
      "type": "quantitative",
      "title": "Average annual rainfall (mm)",
      "scale": {
        "domain": [0, 2000]
      },
      "axis": {
        "grid": true,
        "tickCount": 9,
        "labelOverlap": true
      }
    },
    "y": {
      "field": "LogAbundance",
      "type": "quantitative",
      "title": "Rabbits per kilometre (log-scaled)",
      "scale": {
        "domain": [-0.12, 2.8],
        "nice": false
      },
      "axis": {
        "values": [
          0, 0.30103, 0.778151, 1.041393, 1.322219, 1.70757, 2.004321, 2.303196,
          2.699838
        ],
        "labelExpr": "format(pow(10, datum.value) - 1, '.0f')",
        "grid": true
      }
    },
    "color": {
      "field": "ObservationCount",
      "type": "quantitative",
      "title": "Survey observations",
      "scale": {
        "scheme": "reds",
        "type": "sqrt"
      },
      "legend": {
        "orient": "right",
        "format": ",.0f"
      }
    },
    "tooltip": [
      {
        "field": "RainfallMm",
        "type": "quantitative",
        "title": "Rainfall bin centre (mm)",
        "format": ".0f"
      },
      {
        "field": "LogAbundance",
        "type": "quantitative",
        "title": "log10(1 + rabbits/km)",
        "format": ".2f"
      },
      {
        "field": "ObservationCount",
        "type": "quantitative",
        "title": "Survey observations",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null,
      "fill": "transparent"
    },
    "axis": {
      "gridColor": "#D9CABB",
      "gridOpacity": 0.7,
      "labelFont": "Arial",
      "labelColor": "#735D4D",
      "labelFontSize": 11,
      "titleFont": "Arial",
      "titleColor": "#51372C",
      "titleFontSize": 12,
      "titleFontWeight": "bold"
    },
    "legend": {
      "labelFont": "Arial",
      "labelColor": "#735D4D",
      "labelFontSize": 11,
      "titleFont": "Arial",
      "titleColor": "#51372C",
      "titleFontSize": 12,
      "titleFontWeight": "bold"
    }
  }
}
